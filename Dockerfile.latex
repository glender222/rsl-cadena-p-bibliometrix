FROM debian:trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       latexmk \
       texlive-latex-base \
       texlive-latex-recommended \
       texlive-latex-extra \
       texlive-pictures \
       texlive-lang-spanish \
       texlive-fonts-recommended \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
